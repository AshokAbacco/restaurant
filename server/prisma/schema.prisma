generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  DELETED
}

enum FoodType {
  VEG
  NON_VEG
  EGG
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE_CONSUMPTION
  WASTAGE
  ADJUSTMENT
  RETURN
  TRANSFER
}

enum AdjustmentType {
  INCREASE
  DECREASE
}

enum ValuationMethod {
  FIFO
  AVERAGE_COST
}

enum AlertType {
  LOW_STOCK
  OUT_OF_STOCK
  EXPIRING_SOON
  EXPIRED
}

model Category {
  id            String        @id @default(uuid())
  outletId      String
  outlet        Outlet        @relation(fields: [outletId], references: [id])
  name          String
  description   String?
  imageUrl      String?
  displayOrder  Int           @default(0)
  isEnabled     Boolean       @default(true)
  subCategories SubCategory[]
  menuItems     MenuItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([outletId])
  @@map("categories")
}

model SubCategory {
  id         String     @id @default(uuid())
  outletId   String
  outlet     Outlet     @relation(fields: [outletId], references: [id])
  name       String
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([outletId])
  @@map("sub_categories")
}

model KitchenSection {
  id            String         @id @default(uuid())
  outletId      String
  outlet        Outlet         @relation(fields: [outletId], references: [id])
  name          String
  menuItems     MenuItem[]
  kitchenOrders KitchenOrder[]
  createdAt     DateTime       @default(now())

  @@unique([outletId, name])
  @@index([outletId])
  @@map("kitchen_sections")
}

// A PHYSICAL kitchen — "Ground Floor Kitchen", "Rooftop Kitchen". Distinct
// from KitchenSection above, which is a FUNCTIONAL station (Grill, Beverage)
// that menu items route to automatically via MenuItem.kitchenSectionId.
//
// The two are orthogonal on purpose: a Rooftop Kitchen can have its own grill
// and its own beverage station. A KitchenOrder therefore carries both — the
// branch says WHICH kitchen cooks it, the section says WHICH station inside
// that kitchen. Branch is chosen by the operator at Send-to-Kitchen time;
// section is still derived from the menu item, untouched.
//
// Everything referencing this is nullable, so a single-kitchen restaurant can
// ignore the feature entirely and behaves exactly as before.
model KitchenBranch {
  id       String  @id @default(uuid())
  outletId String
  outlet   Outlet  @relation(fields: [outletId], references: [id])
  name     String
  isActive Boolean @default(true)

  // Optional convenience link to the dining floor this kitchen serves.
  // Deliberately optional and NOT used for routing: takeaway, delivery and
  // online orders have no floor at all but still need a kitchen.
  floorId String?
  floor   Floor?  @relation(fields: [floorId], references: [id])

  orders          Order[]
  kitchenOrders   KitchenOrder[]
  staff           Employee[]
  printerProfiles PrinterProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, name])
  @@index([outletId])
  @@map("kitchen_branches")
}

model MenuItem {
  id        String  @id @default(uuid())
  outletId  String
  outlet    Outlet  @relation(fields: [outletId], references: [id])
  name      String
  shortName String?
  sku       String
  barcode   String?

  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  subCategoryId String?
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  foodType         FoodType        @default(VEG)
  kitchenSectionId String?
  kitchenSection   KitchenSection? @relation(fields: [kitchenSectionId], references: [id])

  sellingPrice  Decimal  @db.Decimal(10, 2)
  costPrice     Decimal? @db.Decimal(10, 2)
  gstPercent    Decimal  @default(0) @db.Decimal(5, 2)
  serviceCharge Decimal? @db.Decimal(10, 2)

  isAvailable     Boolean    @default(true)
  isSeasonal      Boolean    @default(false)
  isHiddenFromPOS Boolean    @default(false)
  status          ItemStatus @default(ACTIVE)

  imageUrl           String?
  description        String?
  prepTimeMinutes    Int?
  targetServeMinutes Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
  orderItems        OrderItem[]
  variants          MenuVariant[]
  menuItemAddOns    MenuItemAddOn[]
  comboLinks        ComboItem[]
  priceHistory      PriceHistory[]

  @@unique([outletId, sku])
  @@index([outletId])
  @@map("menu_items")
}

// ─────────────────────────────────────────────
// INVENTORY / STOCK MANAGEMENT
// ─────────────────────────────────────────────

model Unit {
  id           String   @id @default(uuid())
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id])
  name         String // Kg, Gram, Liter, ml, Piece, Packet, Bottle, Box
  abbreviation String?
  createdAt    DateTime @default(now())

  purchaseUnitIngredients    Ingredient[] @relation("PurchaseUnit")
  consumptionUnitIngredients Ingredient[] @relation("ConsumptionUnit")

  @@unique([outletId, name])
  @@index([outletId])
  @@map("units")
}

model IngredientCategory {
  id          String       @id @default(uuid())
  outletId    String
  outlet      Outlet       @relation(fields: [outletId], references: [id])
  name        String // Vegetables, Meat, Dairy, Beverages, Masala, Oil, Packaging, Cleaning
  description String?
  isEnabled   Boolean      @default(true)
  ingredients Ingredient[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([outletId, name])
  @@index([outletId])
  @@map("ingredient_categories")
}

model Supplier {
  id                 String   @id @default(uuid())
  outletId           String
  outlet             Outlet   @relation(fields: [outletId], references: [id])
  name               String
  contactPerson      String?
  phone              String?
  email              String?
  gstNumber          String?
  address            String?
  paymentTerms       String?
  outstandingBalance Decimal  @default(0) @db.Decimal(12, 2)
  isEnabled          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  purchaseOrders    PurchaseOrder[]
  purchaseEntries   PurchaseEntry[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  assetPurchases    AssetPurchase[]

  @@index([outletId])
  @@map("suppliers")
}

model Ingredient {
  id          String  @id @default(uuid())
  outletId    String
  outlet      Outlet  @relation(fields: [outletId], references: [id])
  name        String
  itemCode    String
  barcode     String?
  description String?

  categoryId String
  category   IngredientCategory @relation(fields: [categoryId], references: [id])

  purchaseUnitId    String
  purchaseUnit      Unit    @relation("PurchaseUnit", fields: [purchaseUnitId], references: [id])
  consumptionUnitId String
  consumptionUnit   Unit    @relation("ConsumptionUnit", fields: [consumptionUnitId], references: [id])
  conversionRatio   Decimal @default(1) @db.Decimal(12, 4) // 1 purchase unit = X consumption units

  minimumStockLevel Decimal @default(0) @db.Decimal(12, 4)
  isEnabled         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryStock     InventoryStock?
  purchaseOrderItems PurchaseOrderItem[]
  purchaseEntries    PurchaseEntry[]
  stockMovements     StockMovement[]
  stockAdjustments   StockAdjustment[]
  wastageRecords     Wastage[]
  expiryBatches      ExpiryBatch[]
  recipeIngredients  RecipeIngredient[]
  inventoryAlerts    InventoryAlert[]

  @@unique([outletId, itemCode])
  @@index([outletId])
  @@map("ingredients")
}

model PurchaseOrder {
  id               String              @id @default(uuid())
  outletId         String
  outlet           Outlet              @relation(fields: [outletId], references: [id])
  poNumber         String
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id])
  purchaseDate     DateTime            @default(now())
  expectedDelivery DateTime?
  status           PurchaseOrderStatus @default(DRAFT)
  totalAmount      Decimal             @default(0) @db.Decimal(12, 2)
  notes            String?

  items           PurchaseOrderItem[]
  purchaseEntries PurchaseEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, poNumber])
  @@index([outletId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])
  quantity        Decimal       @db.Decimal(12, 4)
  unitPrice       Decimal       @db.Decimal(12, 2)
  taxPercent      Decimal       @default(0) @db.Decimal(5, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)

  @@map("purchase_order_items")
}

// Goods receipt — created when stock actually arrives. Increases InventoryStock
// and creates a corresponding StockMovement + optional ExpiryBatch.
model PurchaseEntry {
  id              String         @id @default(uuid())
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  ingredientId    String
  ingredient      Ingredient     @relation(fields: [ingredientId], references: [id])

  outletId         String
  outlet           Outlet    @relation(fields: [outletId], references: [id])
  invoiceNumber    String?
  batchNumber      String?
  expiryDate       DateTime?
  quantityReceived Decimal   @db.Decimal(12, 4) // in purchase units
  purchasePrice    Decimal   @db.Decimal(12, 2) // per purchase unit
  gstPercent       Decimal   @default(0) @db.Decimal(5, 2)
  discount         Decimal   @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal   @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([outletId])
  @@map("purchase_entries")
}

// Current on-hand snapshot per ingredient — always in consumption units.
// Kept in sync by every StockMovement; avoids summing the whole ledger on every read.
model InventoryStock {
  id             String     @id @default(uuid())
  ingredientId   String     @unique
  ingredient     Ingredient @relation(fields: [ingredientId], references: [id])
  quantityOnHand Decimal    @default(0) @db.Decimal(14, 4) // consumption units
  averageCost    Decimal    @default(0) @db.Decimal(12, 4) // cost per consumption unit
  outletId       String
  outlet         Outlet     @relation(fields: [outletId], references: [id])
  updatedAt      DateTime   @updatedAt

  @@index([outletId])
  @@map("inventory_stock")
}

// Full audit ledger — every single stock change, of any kind, lands here.
model StockMovement {
  id            String            @id @default(uuid())
  ingredientId  String
  ingredient    Ingredient        @relation(fields: [ingredientId], references: [id])
  type          StockMovementType
  quantity      Decimal           @db.Decimal(14, 4) // signed: +in / -out, consumption units
  previousStock Decimal           @db.Decimal(14, 4)
  newStock      Decimal           @db.Decimal(14, 4)
  reason        String?
  referenceId   String? // e.g. PurchaseEntry.id, Wastage.id, order id

  // was a plain String before Employee existed — now an optional FK.
  // Scalar column name unchanged, so existing writes of a raw id string still work.
  userId String?
  user   Employee? @relation("StockMovementsByUser", fields: [userId], references: [id])

  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id])
  createdAt DateTime @default(now())

  @@index([ingredientId, createdAt])
  @@index([outletId])
  @@map("stock_movements")
}

model StockAdjustment {
  id           String         @id @default(uuid())
  outletId     String
  outlet       Outlet         @relation(fields: [outletId], references: [id])
  ingredientId String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id])
  type         AdjustmentType
  quantity     Decimal        @db.Decimal(14, 4)
  reason       String
  approvedBy   String?
  notes        String?
  createdAt    DateTime       @default(now())

  @@index([outletId])
  @@map("stock_adjustments")
}

model Wastage {
  id           String     @id @default(uuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  outletId     String
  outlet       Outlet     @relation(fields: [outletId], references: [id])
  quantity     Decimal    @db.Decimal(14, 4)
  reason       String
  cost         Decimal    @db.Decimal(12, 2)

  // now an optional FK to Employee instead of a loose string
  employeeId String?
  employee   Employee? @relation("WastageByEmployee", fields: [employeeId], references: [id])

  createdAt DateTime @default(now())

  @@index([outletId])
  @@map("wastage")
}

model ExpiryBatch {
  id                String     @id @default(uuid())
  outletId          String
  outlet            Outlet     @relation(fields: [outletId], references: [id])
  ingredientId      String
  ingredient        Ingredient @relation(fields: [ingredientId], references: [id])
  batchNumber       String
  manufacturingDate DateTime?
  expiryDate        DateTime
  quantityRemaining Decimal    @db.Decimal(14, 4)
  createdAt         DateTime   @default(now())

  @@index([expiryDate])
  @@index([outletId])
  @@map("expiry_batches")
}

// Links a MenuItem to the ingredients (and quantities) consumed per single unit sold.
model RecipeIngredient {
  id           String     @id @default(uuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(12, 4) // in ingredient's consumption unit
  createdAt    DateTime   @default(now())

  @@unique([menuItemId, ingredientId])
  @@map("recipe_ingredients")
}

// Pre-computed alert rows so the dashboard doesn't have to scan everything live.
model InventoryAlert {
  id           String     @id @default(uuid())
  outletId     String
  outlet       Outlet     @relation(fields: [outletId], references: [id])
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  type         AlertType
  message      String
  isResolved   Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([outletId])
  @@map("inventory_alerts")
}

enum ExpenseStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum ApprovalAction {
  APPROVED
  REJECTED
}

enum ApprovalLevel {
  MANAGER
  FINANCE
}

model ExpenseCategory {
  id          String  @id @default(uuid())
  outletId    String
  outlet      Outlet  @relation(fields: [outletId], references: [id])
  name        String
  description String?
  isDefault   Boolean @default(false) // true for seeded defaults (Rent, Electricity, etc.)
  isEnabled   Boolean @default(true)
  icon        String? @default("FiTag")
  color       String? @default("blue")

  expenses          Expense[]
  recurringExpenses RecurringExpense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, name])
  @@index([outletId])
  @@map("expense_categories")
}

// ─────────────────────────────────────────────
// MULTI-TENANCY — ORGANIZATION / OUTLET
// ─────────────────────────────────────────────
// Organization = the brand/owner account (one signup = one Organization).
// Outlet = a physical restaurant branch under an Organization. Everywhere
// else in this schema, "outletId" is what used to be the free-text
// `store String @default("Main Store")` convention -- that field has been
// removed from every model below in favor of this real relation.
model Organization {
  id         String  @id @default(uuid())
  name       String
  ownerEmail String  @unique
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlets      Outlet[]
  userAccounts UserAccount[]
  // Back-relation for the Owner row created at self-signup (see Owner
  // below). Optional because organizations created any other way (seeds,
  // the backfill script, an outlet added later by an existing owner) have
  // no signup record attached.
  owner        Owner?

  @@map("organizations")
}

// Lets each outlet relabel/recolor the system order statuses for display
// purposes (e.g. "PREPARING" -> "Cooking 👨‍🍳") without touching the actual
// OrderStatus state machine that drives KDS/billing logic — systemStatus
// is always one of the real enum values; customLabel/color are purely
// cosmetic. One row per system status per outlet (an outlet either has a
// customization for a given status, or the frontend falls back to the
// plain enum value — see settings.service.js).
model OrderStatusLabel {
  id       String @id @default(uuid())
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  systemStatus OrderStatus
  customLabel  String
  color        String? // hex or Tailwind token, frontend's choice how to use it
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, systemStatus])
  @@index([outletId])
  @@map("order_status_labels")
}

model Outlet {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String
  address         String?
  phone           String?
  gstin           String?
  // Printed on the invoice header. FSSAI licence number is legally required
  // on restaurant bills in India; tagline is the line under the name
  // ("Authentic Multi-Cuisine Fine Dining"). Both optional — the invoice
  // simply omits the row when they're not set.
  fssai           String?
  tagline         String?
  timezone        String? @default("Asia/Kolkata")
  defaultLanguage String? @default("en")
  isActive        Boolean @default(true)

  // ── Restaurant profile (Settings -> Restaurant Profile) ────────────────
  // These back the profile form, which previously had nowhere to save to —
  // it was a pure mockup with no handler and no matching columns. All
  // nullable: an outlet created before this, or one that never fills the
  // form in, is completely unaffected.
  legalBusinessName String?
  restaurantType    String? // Restaurant, Cafe, Bar, Cloud Kitchen...
  description       String?
  logoUrl           String?
  bannerUrl         String?

  // Statutory identifiers other than gstin/fssai above
  panNumber          String?
  registrationNumber String?

  // Address broken out. `address` above stays the single-line form used on
  // the invoice header and is kept in sync by the profile form.
  city    String?
  state   String?
  pincode String?
  country String? @default("India")

  // "HH:mm" strings rather than DateTime — these are wall-clock opening
  // hours, not instants, and storing them as DateTime would drag timezone
  // conversion into something that should just print as typed.
  openingTime String?
  closingTime String?

  email           String?
  website         String?
  whatsapp        String?
  alternateMobile String?

  currency String? @default("INR")

  facebookUrl       String?
  instagramUrl      String?
  googleBusinessUrl String?
  googleMapsUrl     String?

  // ── Bill QR / barcode (Settings -> QR Settings) ───────────────────────
  // upiId is the VPA the payment QR is built from ("royalspice@ybl"). The QR
  // itself is never stored — it's a deterministic render of a `upi://pay`
  // string built per-bill from this VPA plus that bill's amount and
  // reference, so storing an image would only go stale.
  upiId           String?
  upiPayeeName    String? // shown in the payer's UPI app; defaults to the outlet name
  showBillQr      Boolean @default(true)
  showBillBarcode Boolean @default(true)
  billFooterNote  String? // e.g. "Thank you! Free Wi-Fi: RoyalSpiceGuest"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Back-relations -- one array field per model that carries outletId below.
  categories             Category[]
  subCategories          SubCategory[]
  kitchenSections        KitchenSection[]
  kitchenBranches        KitchenBranch[]
  menuItems              MenuItem[]
  menuVariants           MenuVariant[]
  addOns                 AddOn[]
  comboMeals             ComboMeal[]
  units                  Unit[]
  ingredientCategories   IngredientCategory[]
  suppliers              Supplier[]
  ingredients            Ingredient[]
  purchaseOrders         PurchaseOrder[]
  purchaseEntries        PurchaseEntry[]
  inventoryStocks        InventoryStock[]
  stockMovements         StockMovement[]
  stockAdjustments       StockAdjustment[]
  wastages               Wastage[]
  expiryBatches          ExpiryBatch[]
  inventoryAlerts        InventoryAlert[]
  expenseCategories      ExpenseCategory[]
  expenses               Expense[]
  recurringExpenses      RecurringExpense[]
  payrollRecords         PayrollRecord[]
  salaryExpenses         SalaryExpense[]
  utilityBills           UtilityBill[]
  pettyCashSessions      PettyCashSession[]
  assetPurchases         AssetPurchase[]
  employees              Employee[]
  userAccounts           UserAccount[]
  refreshTokens          RefreshToken[]
  attendances            Attendance[]
  shifts                 Shift[]
  shiftAssignments       ShiftAssignment[]
  leaveRequests          LeaveRequest[]
  incentives             Incentive[]
  performanceRecords     PerformanceRecord[]
  activityLogs           ActivityLog[]
  floors                 Floor[]
  restaurantTables       RestaurantTable[]
  customers              Customer[]
  deliveryPartners       DeliveryPartner[]
  orders                 Order[]
  kitchenOrders          KitchenOrder[]
  invoices               Invoice[]
  loyaltyTransactions    LoyaltyTransaction[]
  discounts              Discount[]
  priceHistories         PriceHistory[]
  auditLogs              AuditLog[]
  orderStatusLabels      OrderStatusLabel[]
  duePayments            DuePayment[]
  duePaymentSettlements  DuePaymentSettlement[]
  tableReservations      TableReservation[]
  billingCounters        BillingCounter[]
  cashDrawerSessions     CashDrawerSession[]
  cashDrawerTransactions CashDrawerTransaction[]
  onlinePlatforms        OnlinePlatform[]
  printerProfiles        PrinterProfile[]
  owner                  Owner?

  @@unique([organizationId, name])
  @@map("outlets")
}

// Core expense record. Utility bills and petty cash entries also live here
// (via isPettyCash / pettyCashSessionId) so P&L can sum one table for totals,
// while UtilityBill/PettyCashSession hold the feature-specific metadata.
model Expense {
  id            String @id @default(uuid())
  expenseNumber String // auto-generated, e.g. EXP-000123

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  title       String
  description String?
  expenseDate DateTime @default(now())

  amount    Decimal @db.Decimal(12, 2)
  gstAmount Decimal @default(0) @db.Decimal(12, 2)
  discount  Decimal @default(0) @db.Decimal(12, 2)
  totalPaid Decimal @db.Decimal(12, 2)

  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  invoiceNumber String?

  paymentMethod        PaymentMethod?
  paymentStatus        PaymentStatus  @default(UNPAID)
  paymentDate          DateTime?
  transactionReference String?

  status   ExpenseStatus @default(DRAFT)
  outletId String
  outlet   Outlet        @relation(fields: [outletId], references: [id])

  isPettyCash        Boolean           @default(false)
  pettyCashSessionId String?
  pettyCashSession   PettyCashSession? @relation(fields: [pettyCashSessionId], references: [id])

  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])

  // now an optional FK to Employee instead of a loose string
  createdBy         String?
  createdByEmployee Employee? @relation("ExpensesCreatedBy", fields: [createdBy], references: [id])

  attachments ExpenseAttachment[]
  approvals   ExpenseApproval[]
  auditLogs   ExpenseAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, expenseNumber])
  @@index([expenseDate])
  @@index([status])
  @@index([outletId])
  @@map("expenses")
}

model ExpenseAttachment {
  id         String   @id @default(uuid())
  expenseId  String
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileKey    String // R2 object key
  fileUrl    String
  fileType   String // pdf / jpg / png
  uploadedAt DateTime @default(now())

  @@map("expense_attachments")
}

// Template for recurring expenses (Rent, Internet, Software Subscription...).
// A scheduler reads isActive + nextDueDate and spins off real Expense rows.
model RecurringExpense {
  id         String          @id @default(uuid())
  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  title  String
  amount Decimal @db.Decimal(12, 2)

  frequency          RecurringFrequency
  nextDueDate        DateTime
  reminderDaysBefore Int                @default(3)
  isActive           Boolean            @default(true)

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  outletId   String
  outlet     Outlet    @relation(fields: [outletId], references: [id])

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@map("recurring_expenses")
}

// Audit trail for the approval workflow (Manager -> Finance).
model ExpenseApproval {
  id        String         @id @default(uuid())
  expenseId String
  expense   Expense        @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  action    ApprovalAction
  level     ApprovalLevel

  // now an optional FK to Employee instead of a loose string
  approverId String?
  approver   Employee? @relation("ExpenseApprovalsByApprover", fields: [approverId], references: [id])

  comment   String?
  createdAt DateTime @default(now())

  @@map("expense_approvals")
}

// HR-side monthly payroll computation for an employee (basic + allowances -
// deductions = net). When processed/paid, a corresponding SalaryExpense row
// is created below so it lands in the accounting/P&L ledger too.
model PayrollRecord {
  id         String   @id @default(uuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  month       String // "2026-07"
  basicSalary Decimal      @db.Decimal(12, 2)
  allowances  Decimal      @default(0) @db.Decimal(12, 2)
  bonus       Decimal      @default(0) @db.Decimal(12, 2)
  overtimePay Decimal      @default(0) @db.Decimal(12, 2)
  deductions  Decimal      @default(0) @db.Decimal(12, 2)
  netSalary   Decimal      @db.Decimal(12, 2)
  status      SalaryStatus @default(PENDING)

  // filled in once this payroll run has been pushed into the Expense ledger
  salaryExpenseId String?        @unique
  salaryExpense   SalaryExpense? @relation(fields: [salaryExpenseId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, month])
  @@index([outletId])
  @@map("payroll_records")
}

// Accounting-side ledger entry (unchanged shape, now linked to a real Employee
// where one exists; employeeName kept for cases without a system account).
model SalaryExpense {
  id           String    @id @default(uuid())
  employeeName String
  employeeId   String?
  employee     Employee? @relation("SalaryExpensesByEmployee", fields: [employeeId], references: [id])
  salaryMonth  DateTime // stored as the 1st of the month

  baseSalary Decimal @db.Decimal(12, 2)
  bonus      Decimal @default(0) @db.Decimal(12, 2)
  incentives Decimal @default(0) @db.Decimal(12, 2)
  overtime   Decimal @default(0) @db.Decimal(12, 2)
  deductions Decimal @default(0) @db.Decimal(12, 2)
  netSalary  Decimal @db.Decimal(12, 2)

  paymentStatus PaymentStatus @default(UNPAID)
  paymentDate   DateTime?
  outletId      String
  outlet        Outlet        @relation(fields: [outletId], references: [id])

  payrollRecord PayrollRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salaryMonth])
  @@index([outletId])
  @@map("salary_expenses")
}

model UtilityBill {
  id                 String        @id @default(uuid())
  utilityType        String // Electricity, Water, Gas, Internet
  billNumber         String?
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  dueDate            DateTime
  paymentDate        DateTime?
  amount             Decimal       @db.Decimal(12, 2)
  paymentStatus      PaymentStatus @default(UNPAID)
  outletId           String
  outlet             Outlet        @relation(fields: [outletId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dueDate])
  @@index([outletId])
  @@map("utility_bills")
}

// A session/ledger period (e.g. one per day or week per store).
// Individual petty cash spends are Expense rows with isPettyCash=true,
// linked back here via pettyCashSessionId.
model PettyCashSession {
  id             String    @id @default(uuid())
  outletId       String
  outlet         Outlet    @relation(fields: [outletId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime?
  openingBalance Decimal   @db.Decimal(12, 2)
  closingBalance Decimal?  @db.Decimal(12, 2)
  isClosed       Boolean   @default(false)

  expenses Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@map("petty_cash_sessions")
}

// A cash drawer/till session — NOT the same concept as PettyCashSession
// above (that's for tracking small cash purchases as an expense category;
// this is for reconciling the actual cash sitting in the drawer against
// what sales+top-ups-withdrawals say should be there). A biller opens one
// at the start of their shift with a starting float, every cash sale/
// withdrawal/top-up/conversion during the shift is logged against it (see
// CashDrawerTransaction), and it's closed out at end of shift by counting
// the physical cash and comparing to what the ledger expects.
model CashDrawerSession {
  id       String @id @default(uuid())
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  openedById String?
  openedBy   Employee? @relation("CashDrawerSessionsOpenedBy", fields: [openedById], references: [id])

  openingFloat Decimal  @db.Decimal(10, 2)
  openedAt     DateTime @default(now())

  closedById String?
  closedBy   Employee? @relation("CashDrawerSessionsClosedBy", fields: [closedById], references: [id])

  closedAt              DateTime?
  closingCounted        Decimal?  @db.Decimal(10, 2)
  expectedClosingAmount Decimal?  @db.Decimal(10, 2)

  status CashDrawerSessionStatus @default(OPEN)
  notes  String?

  transactions CashDrawerTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@index([status])
  @@map("cash_drawer_sessions")
}

// One float movement against an open session. SALE rows are created
// automatically whenever a cash payment is recorded at billing (see
// billing.service.js) — never entered by hand. WITHDRAWAL/TOP_UP/
// CURRENCY_CONVERSION are the manual actions a biller takes during a
// shift (e.g. sending cash to the office safe, or breaking a large note).
model CashDrawerTransaction {
  id       String @id @default(uuid())
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  sessionId String
  session   CashDrawerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type   CashDrawerTransactionType
  amount Decimal                   @db.Decimal(10, 2)
  reason String?

  // Only meaningful for type CURRENCY_CONVERSION — a foreign-currency cash
  // payment logged and converted at a recorded rate, so the drawer's INR
  // total stays reconcilable even when a customer paid in another currency.
  fromCurrency String?
  toCurrency   String?
  exchangeRate Decimal? @db.Decimal(12, 6)

  performedById String?
  performedBy   Employee? @relation("CashDrawerTransactionsByEmployee", fields: [performedById], references: [id])

  createdAt DateTime @default(now())

  @@index([outletId])
  @@index([sessionId])
  @@map("cash_drawer_transactions")
}

enum CashDrawerSessionStatus {
  OPEN
  CLOSED
}

enum CashDrawerTransactionType {
  SALE
  WITHDRAWAL
  TOP_UP
  CURRENCY_CONVERSION
}

model AssetPurchase {
  id             String    @id @default(uuid())
  assetName      String
  assetCategory  String? // Furniture, Kitchen Equipment, Computers, Printers, POS Devices
  purchaseDate   DateTime  @default(now())
  cost           Decimal   @db.Decimal(12, 2)
  warrantyExpiry DateTime?

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  outletId   String
  outlet     Outlet    @relation(fields: [outletId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@map("asset_purchases")
}

model ExpenseAuditLog {
  id        String  @id @default(uuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  action    String // CREATE, UPDATE, DELETE, APPROVE, REJECT

  // now an optional FK to Employee instead of a loose string
  changedBy         String?
  changedByEmployee Employee? @relation("ExpenseAuditLogsByEmployee", fields: [changedBy], references: [id])

  oldValue  Json?
  newValue  Json?
  createdAt DateTime @default(now())

  @@map("expense_audit_logs")
}

// ─────────────────────────────────────────────
// EMPLOYEE & STAFF MANAGEMENT
// ─────────────────────────────────────────────

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  TERMINATED
}

enum RoleName {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  CHEF
  KITCHEN
  WAITER
  STORE_KEEPER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

enum AttendanceEventType {
  CLOCK_IN
  CLOCK_OUT
  BREAK_START
  BREAK_END
}

enum LeaveType {
  CASUAL
  SICK
  PAID
  EMERGENCY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SalaryStatus {
  PAID
  PENDING
}

model Employee {
  id               String    @id @default(uuid())
  employeeCode     String // auto-generated, e.g. EMP-0001 — unique per outlet, see @@unique below
  fullName         String
  photoUrl         String?
  gender           String?
  dob              DateTime?
  mobile           String?
  email            String? // personal contact email — not the login email (see UserAccount.email); intentionally not unique, two employees at different outlets may share a family email
  emergencyContact String?

  department     String // free text — Kitchen, Service, Inventory...
  designation    String // free text — Chef, Waiter, Cashier...
  joiningDate    DateTime
  employmentType String? // free text — full-time / part-time / contract
  status         EmployeeStatus @default(ACTIVE)
  outletId       String
  outlet         Outlet         @relation(fields: [outletId], references: [id])

  // Kitchen staff assigned to a specific physical kitchen only see that
  // kitchen's tickets on the Kitchen Display. Null = sees every kitchen,
  // which is the right default for owners, managers and single-kitchen sites.
  kitchenBranchId String?
  kitchenBranch   KitchenBranch? @relation(fields: [kitchenBranchId], references: [id])

  invoicesBilled Invoice[] @relation("InvoicesByCashier")

  address            EmployeeAddress?
  userAccount        UserAccount?
  attendance         Attendance[]
  attendanceLogs     AttendanceLog[]
  shiftAssignments   ShiftAssignment[]
  leaveRequests      LeaveRequest[]
  approvedLeaves     LeaveRequest[]      @relation("LeaveApprovedBy")
  payrollRecords     PayrollRecord[]
  incentives         Incentive[]
  approvedIncentives Incentive[]         @relation("IncentiveApprovedBy")
  performanceRecords PerformanceRecord[]
  activityLogs       ActivityLog[]

  // reverse relations into existing modules
  stockMovements   StockMovement[]   @relation("StockMovementsByUser")
  wastageRecords   Wastage[]         @relation("WastageByEmployee")
  expensesCreated  Expense[]         @relation("ExpensesCreatedBy")
  expenseApprovals ExpenseApproval[] @relation("ExpenseApprovalsByApprover")
  salaryExpenses   SalaryExpense[]   @relation("SalaryExpensesByEmployee")
  expenseAuditLogs ExpenseAuditLog[] @relation("ExpenseAuditLogsByEmployee")

  ordersAsWaiter    Order[]           @relation("OrdersByWaiter")
  assignedTables    RestaurantTable[] @relation("TablesByWaiter")
  discountsApproved OrderDiscount[]   @relation("DiscountsApprovedBy")

  kitchenOrdersAsChef             KitchenOrder[]          @relation("KOTsByChef")
  duePaymentSettlements           DuePaymentSettlement[]  @relation("DuePaymentSettlementsByEmployee")
  reservationsCreated             TableReservation[]      @relation("ReservationsByEmployee")
  cashDrawerSessionsOpened        CashDrawerSession[]     @relation("CashDrawerSessionsOpenedBy")
  cashDrawerSessionsClosed        CashDrawerSession[]     @relation("CashDrawerSessionsClosedBy")
  cashDrawerTransactionsPerformed CashDrawerTransaction[] @relation("CashDrawerTransactionsByEmployee")
  kitchenStatusChanges            KitchenOrderStatusLog[] @relation("KOTStatusChangedBy")
  kitchenNotes                    KitchenNote[]           @relation("KitchenNotesByChef")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, employeeCode])
  @@index([department])
  @@index([designation])
  @@index([status])
  @@index([outletId])
  @@map("employees")
}

model EmployeeAddress {
  id         String   @id @default(uuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String   @unique

  houseNo String?
  street  String?
  city    String?
  state   String?
  pincode String?

  @@map("employee_addresses")
}

// Login schema only — no auth middleware wired yet.
model UserAccount {
  id             String       @id @default(uuid())
  outletId       String
  outlet         Outlet       @relation(fields: [outletId], references: [id])
  // Denormalized alongside outletId so we can resolve "which orgs can this login
  // access" and switch outlets without a join through Outlet every time (see
  // POST /api/auth/select-outlet). Must always equal outlet.organizationId —
  // enforced in the service layer, not at the DB level.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId     String       @unique

  // Unique per organization, not per outlet — one owner login should be able to
  // use the same username across every outlet they own.
  username            String
  // Globally unique across the whole platform — this is the login/password-reset
  // lookup key before an organization is even known.
  email               String?   @unique
  passwordHash        String
  pin                 String? // optional, for POS quick login
  role                RoleName
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]       @relation("RefreshTokensByUser")
  owner               Owner?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, username])
  @@index([role])
  @@index([outletId])
  @@index([organizationId])
  @@map("user_accounts")
}

// ==============================================
// OWNER — self-signup record (POST /api/auth/register)
// ==============================================
//

model Owner {
  id String @id @default(uuid())

  // ---- Fields collected on the Register page ----
  restaurantName String
  fullName       String
  phone          String
  // Globally unique — the same address is also written to
  // UserAccount.email (the login key) and Organization.ownerEmail, and all
  // three are created together in one transaction, so they never diverge.
  email          String @unique
  address        String

  // ---- What the signup created ----
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // The first outlet, created from the restaurant name/address/phone above.
  // The owner can add more outlets later; this one stays recorded as the
  // outlet the account started from.
  outletId       String       @unique
  outlet         Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  // The OWNER-role login this signup produced. Cascade so deleting the
  // account doesn't leave an orphaned signup row behind.
  userAccountId  String       @unique
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("owners")
}

// Short-lived token issued for the "forgot password" flow. Only the hash is
// stored — the raw token is emailed to the user and never persisted.
model PasswordResetToken {
  id            String      @id @default(uuid())
  userAccountId String
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Long-lived refresh tokens (httpOnly cookie on the client). Stored hashed so
// a DB leak doesn't hand out usable tokens; revoked on logout / password change.
model RefreshToken {
  id            String      @id @default(uuid())
  userAccountId String
  userAccount   UserAccount @relation("RefreshTokensByUser", fields: [userAccountId], references: [id], onDelete: Cascade)
  // Which outlet this session was for — an OWNER/ADMIN can hold sessions
  // for different outlets from different devices/tabs simultaneously, so
  // this can't be derived from the account alone; it has to be recorded
  // per-session, at login/select-outlet time, and echoed back into the
  // access token on every /refresh (see auth.service.js).
  outletId      String
  outlet        Outlet      @relation(fields: [outletId], references: [id])
  tokenHash     String      @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([userAccountId])
  @@index([outletId])
  @@map("refresh_tokens")
}

// Daily rollup — one row per employee per day.
model Attendance {
  id         String   @id @default(uuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  date          DateTime         @db.Date
  clockIn       DateTime?
  clockOut      DateTime?
  workingHours  Decimal?         @db.Decimal(5, 2)
  overtimeHours Decimal?         @db.Decimal(5, 2)
  status        AttendanceStatus @default(PRESENT)
  outletId      String
  outlet        Outlet           @relation(fields: [outletId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@index([outletId])
  @@map("attendance")
}

// Raw event log — clock-in/out and break events, multiple per day.
model AttendanceLog {
  id         String   @id @default(uuid())
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  eventType AttendanceEventType
  timestamp DateTime            @default(now())
  ipAddress String?
  device    String?

  @@index([employeeId, timestamp])
  @@map("attendance_logs")
}

model Shift {
  id        String @id @default(uuid())
  name      String // Morning / Afternoon / Night / Custom
  startTime String // "09:00"
  endTime   String // "17:00"
  outletId  String
  outlet    Outlet @relation(fields: [outletId], references: [id])

  assignments ShiftAssignment[]

  createdAt DateTime @default(now())

  @@index([outletId])
  @@map("shifts")
}

model ShiftAssignment {
  id         String   @id @default(uuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String
  shift      Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  shiftId    String

  date DateTime @db.Date

  @@unique([employeeId, date])
  @@index([shiftId, date])
  @@index([outletId])
  @@map("shift_assignments")
}

model LeaveRequest {
  id         String   @id @default(uuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  type     LeaveType
  fromDate DateTime
  toDate   DateTime
  reason   String?
  status   LeaveStatus @default(PENDING)

  approvedById String?
  approvedBy   Employee? @relation("LeaveApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, status])
  @@index([outletId])
  @@map("leave_requests")
}

model Incentive {
  id         String   @id @default(uuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  type   String // free text — Sales Target Bonus, Attendance Bonus, Festival Bonus
  amount Decimal @db.Decimal(12, 2)
  reason String?

  approvedById String?
  approvedBy   Employee? @relation("IncentiveApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())

  @@index([outletId])
  @@map("incentives")
}

model PerformanceRecord {
  id         String   @id @default(uuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  period         String // "2026-07"
  ordersServed   Int?     @default(0)
  salesGenerated Decimal? @default(0) @db.Decimal(12, 2)
  customerRating Decimal? @db.Decimal(3, 2)
  lateArrivals   Int?     @default(0)

  @@unique([employeeId, period])
  @@index([outletId])
  @@map("performance_records")
}

model ActivityLog {
  id         String   @id @default(uuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  action    String // e.g. "Login", "Created Order", "Updated Inventory"
  ipAddress String?
  device    String?
  createdAt DateTime @default(now())

  @@index([employeeId, createdAt])
  @@index([outletId])
  @@map("employee_activity_logs")
}

// ─────────────────────────────────────────────
// POS / ORDERS
// ─────────────────────────────────────────────

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
  REFUNDED
  ON_HOLD
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  COUPON
  MEMBERSHIP
  MANUAL
}

enum KotStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
  RECALLED
}

enum KotPriority {
  NORMAL
  VIP
  ONLINE_DELIVERY
  EXPRESS
  SENIOR_CITIZEN
  SPECIAL_REQUEST
}

enum SplitType {
  EQUAL
  ITEM_WISE
  CUSTOM
}

// A floor/section of the restaurant, e.g. "Ground Floor", "Rooftop".
// Tables are grouped under a floor for the Tables Management page (floor
// tabs + per-floor table grid).
model Floor {
  id       String @id @default(uuid())
  name     String
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  tables          RestaurantTable[]
  kitchenBranches KitchenBranch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@map("floors")
}

model RestaurantTable {
  id       String      @id @default(uuid())
  name     String // e.g. "T-12"
  capacity Int?
  section  String? // legacy free-text grouping, kept for back-compat with existing filters
  status   TableStatus @default(FREE)
  outletId String
  outlet   Outlet      @relation(fields: [outletId], references: [id])

  floorId String?
  floor   Floor?  @relation(fields: [floorId], references: [id])

  // Waiter assignment — a table is assigned to at most one waiter at a time.
  // Owner/Manager assigns via /pos/tables/assign* endpoints; the waiter then
  // only sees orders/payments for tables where waiterId === their own id.
  waiterId   String?
  waiter     Employee? @relation("TablesByWaiter", fields: [waiterId], references: [id])
  assignedAt DateTime?

  orders       Order[]
  reservations TableReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([floorId])
  @@index([waiterId])
  @@index([outletId])
  @@map("restaurant_tables")
}

// A future booking against a specific table. Deliberately keeps its own
// customerName/customerPhone fields rather than a required Customer FK —
// a reservation is very often taken over the phone before anyone decides
// whether to also create a full Customer record, and shouldn't be blocked
// on that decision. customerId is optional, filled in only when the
// booking is linked to an existing Customer.
model TableReservation {
  id       String @id @default(uuid())
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  tableId String
  table   RestaurantTable @relation(fields: [tableId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerName    String
  customerPhone   String?
  partySize       Int
  reservedFor     DateTime
  durationMinutes Int               @default(90)
  status          ReservationStatus @default(BOOKED)
  notes           String?

  // Set by the corresponding status-transition endpoint
  // (seat/cancel/no-show/complete) — each is null until that transition
  // happens, matching how the other Xat timestamp fields are used
  // elsewhere in this schema.
  seatedAt    DateTime?
  cancelledAt DateTime?
  noShowAt    DateTime?
  completedAt DateTime?

  createdById String?
  createdBy   Employee? @relation("ReservationsByEmployee", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@index([tableId])
  @@index([reservedFor])
  @@index([status])
  @@map("table_reservations")
}

enum ReservationStatus {
  BOOKED
  SEATED
  CANCELLED
  NO_SHOW
  COMPLETED
}

model Customer {
  id            String  @id @default(uuid())
  outletId      String
  outlet        Outlet  @relation(fields: [outletId], references: [id])
  name          String
  mobile        String
  email         String?
  address       String?
  landmark      String?
  loyaltyPoints Int     @default(0)

  orders              Order[]
  loyaltyTransactions LoyaltyTransaction[]
  duePayments         DuePayment[]
  reservations        TableReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, mobile])
  @@index([mobile])
  @@index([outletId])
  @@map("customers")
}

model DeliveryPartner {
  id       String  @id @default(uuid())
  outletId String
  outlet   Outlet  @relation(fields: [outletId], references: [id])
  name     String
  phone    String?
  isActive Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())

  @@index([outletId])
  @@map("delivery_partners")
}

// A bill that wasn't fully paid at billing time — the remaining balance is
// tracked here as outstanding debt against a customer, settled later in
// full or in installments (see DuePaymentSettlement). One row per Order;
// an order is either fully paid at billing (no DuePayment row at all) or
// has exactly one, whose status tracks how much of it has been settled
// since.
model DuePayment {
  id       String @id @default(uuid())
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  originalAmount Decimal          @db.Decimal(10, 2)
  amountPaid     Decimal          @default(0) @db.Decimal(10, 2)
  status         DuePaymentStatus @default(OUTSTANDING)

  settlements DuePaymentSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([outletId])
  @@index([customerId])
  @@index([status])
  @@map("due_payments")
}

// One installment/settlement against a DuePayment — a customer can clear
// their tab in several visits, each one logged here for a full audit
// trail of who collected what, when, and by which method.
model DuePaymentSettlement {
  id           String     @id @default(uuid())
  outletId     String
  outlet       Outlet     @relation(fields: [outletId], references: [id])
  duePaymentId String
  duePayment   DuePayment @relation(fields: [duePaymentId], references: [id], onDelete: Cascade)

  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod

  settledById String?
  settledBy   Employee? @relation("DuePaymentSettlementsByEmployee", fields: [settledById], references: [id])

  settledAt DateTime @default(now())
  notes     String?

  @@index([outletId])
  @@index([duePaymentId])
  @@map("due_payment_settlements")
}

enum DuePaymentStatus {
  OUTSTANDING
  PARTIALLY_PAID
  SETTLED
}

// Represents a physical POS terminal/billing station (e.g. "Counter 1",
// "Captain", "Billing Station") — matches PetPooja's Counter Summary
// report, which groups sales by which physical device processed them.
// Deliberately a device-level identity, not a staff-level one: the same
// physical terminal keeps its counter identity across shifts regardless
// of who's logged into it, and one staff member's login can be used at
// different counters at different times (see counter-selection on the
// client — a per-browser choice, not part of the JWT).
model BillingCounter {
  id       String @id @default(uuid())
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  name     String
  isActive Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, name])
  @@index([outletId])
  @@map("billing_counters")
}

// Thermal printer / paper geometry, per outlet. One row per physical printer
// model an outlet actually owns ("Posiflow KP307-UEWB", "Sunmi V2 handheld").
//
// This exists because a receipt is laid out against PAPER, not a screen: an
// 80mm roll gives ~72mm of printable width, a 58mm roll gives ~48mm, and a
// layout tuned for one is unreadable on the other. The KOT and the invoice
// read these numbers at print time (client/src/print/printing.js) and size
// @page, the font and the item columns from them, instead of the 80mm
// constants that used to be hard-coded.
//
// Deactivated rather than deleted (isActive), same reasoning as
// BillingCounter — an outlet that retires a printer shouldn't break the
// devices still pointing at that profile mid-shift.
model PrinterProfile {
  id       String @id @default(uuid())
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  // What staff pick from ("Front counter — Posiflow 80mm").
  name  String
  // Manufacturer model string, e.g. "Posiflow KP307-UEWB".
  model String?

  // ---- Paper geometry -------------------------------------------------
  // Physical roll width (80 / 70 / 58). paperWidthMm - printableWidthMm is
  // the unprintable edge the print margin has to leave alone, which is what
  // stops content being clipped or shifted to one side.
  paperWidthMm     Int @default(80)
  printableWidthMm Int @default(72)
  // Head resolution across the printable area (576 dots on a 72mm 203dpi
  // head). Reference/diagnostic only — the browser lays out in CSS px.
  printableDots    Int @default(576)
  // Characters per line in the printer's own Font A. Not used to measure
  // text (the browser does that in `ch` units), but it IS the signal for
  // how much a layout can hold: under ~40 the invoice meta block drops from
  // two columns to one rather than wrapping every line in half.
  columns          Int @default(48)

  // ---- Print behaviour ------------------------------------------------
  // Rated feed speed, e.g. 300 mm/s. Informational.
  speedMmPerSec Int?  @default(300)
  // Base font size the receipt renders at on paper. Kept explicit rather
  // than derived from `columns`: derived sizing shrank an 80mm bill that
  // was already correct, because almost no receipt line uses the printer's
  // full character capacity.
  baseFontPx    Float @default(10)
  // Extra margin beyond the unprintable edge, for printers whose driver
  // already inserts its own.
  extraMarginMm Float @default(0)

  // ---- Routing --------------------------------------------------------
  // WHAT this printer is for. A kitchen printer must never receive an
  // invoice (it would hand a customer a slip with no prices, or worse, put
  // the bill in the kitchen), and a cashier printer must never receive a
  // KOT. This is the field that separates the two streams.
  //   KOT     — kitchen tickets only
  //   INVOICE — bills/receipts only
  //   BOTH    — single-printer outlets, the previous behaviour
  purpose String @default("BOTH")

  // WHICH physical kitchen this printer sits in. Required in practice for
  // purpose=KOT once an outlet runs more than one kitchen: it is what routes
  // an order's ticket to the right room. Null means "any kitchen", which is
  // correct for a single-kitchen outlet and for INVOICE printers.
  //
  // KitchenBranch, not KitchenSection: sections (Grill, Beverage) are
  // functional and several share one physical printer; branches are rooms,
  // and rooms are where printers live.
  kitchenBranchId String?
  kitchenBranch   KitchenBranch? @relation(fields: [kitchenBranchId], references: [id])

  // ---- Connection -----------------------------------------------------
  // How the printer is reached. Informational for now: the browser prints
  // through the OS print dialog, so this records what staff plugged in
  // rather than driving a transport.
  connectionType String? @default("SYSTEM") // SYSTEM | NETWORK | USB | BLUETOOTH
  ipAddress      String?

  // ---- Print behaviour per printer -------------------------------------
  // These used to live as component state on the Printer Settings mockup and
  // were lost on refresh. They hang off the printer rather than the outlet
  // because they genuinely differ per device: the kitchen printer auto-prints
  // KOTs and must never show prices, the counter printer auto-prints receipts
  // and opens a cash drawer.
  copies           Int     @default(1)
  autoPrintKot     Boolean @default(true)
  autoPrintReceipt Boolean @default(true)
  autoPrintInvoice Boolean @default(false)
  allowReprint     Boolean @default(true)
  printLogo        Boolean @default(true)
  printGstDetails  Boolean @default(true)
  printQrCode      Boolean @default(true)
  printBarcode     Boolean @default(false)
  printItemNotes   Boolean @default(true)
  printTableNumber Boolean @default(true)
  printOrderTime   Boolean @default(true)
  openCashDrawer   Boolean @default(false)

  // Free-text device label, e.g. "Front counter terminal".
  deviceLabel String?
  notes       String?

  // Exactly one default PER PURPOSE per outlet — enforced in the service,
  // which clears the previous default in the same transaction. Scoped by
  // purpose because an outlet needs a default KOT printer and a default
  // invoice printer at the same time; a single global default can't express
  // that.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, name])
  @@index([outletId])
  @@index([outletId, purpose, isActive])
  @@index([kitchenBranchId])
  @@map("printer_profiles")
}

// Online Orders — list of aggregator names (Swiggy, Zomato, etc.) a
// manually-keyed-in order can be tagged with. This is NOT a live
// aggregator integration (no menu sync, no webhooks, no automatic order
// import) — see onlinePlatforms.service.js. Soft-deactivated only
// (isActive), never hard-deleted, so past orders stay attributable to a
// real platform name in reports.
model OnlinePlatform {
  id       String @id @default(uuid())
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id])

  name     String
  isActive Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, name])
  @@index([outletId])
  @@map("online_platforms")
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String // e.g. ORD-000123
  orderType   OrderType
  status      OrderStatus @default(NEW)
  holdNumber  String?

  // FEATURE: offline mode, phase 1 step 6 (idempotency). Generated
  // client-side (crypto.randomUUID()) the moment an order is created
  // OFFLINE, before it's ever synced to the server — see
  // client/src/offline/offlineQueue.js. On sync, pos.service.js's
  // createOrder checks for an existing row with this id FIRST and returns
  // it instead of inserting again, so a sync that's retried after a
  // dropped response (order actually saved, but the client never got the
  // 200) can never create a duplicate order. Null for orders created
  // normally (online, no offline queue involved).
  clientRequestId String? @unique

  tableId String?
  table   RestaurantTable? @relation(fields: [tableId], references: [id])

  // Which physical POS terminal/counter this order was billed through —
  // optional (older orders, or an outlet that hasn't set up counters yet,
  // simply have null here) — see BillingCounter above.
  counterId String?
  counter   BillingCounter? @relation(fields: [counterId], references: [id])

  // Online Orders — optionally tags this order as having come in from an
  // aggregator (Swiggy, Zomato, etc.). Purely a label for display/reports;
  // see OnlinePlatform above for why this isn't a live integration.
  onlinePlatformId String?
  onlinePlatform   OnlinePlatform? @relation(fields: [onlinePlatformId], references: [id])

  // Which physical kitchen this order was routed to. Nullable: orders placed
  // before this feature, and outlets with a single kitchen, simply have none.
  kitchenBranchId String?
  kitchenBranch   KitchenBranch? @relation(fields: [kitchenBranchId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  waiterId String?
  waiter   Employee? @relation("OrdersByWaiter", fields: [waiterId], references: [id])

  numberOfGuests Int?

  // delivery-specific
  deliveryPartnerId     String?
  deliveryPartner       DeliveryPartner? @relation(fields: [deliveryPartnerId], references: [id])
  deliveryCharge        Decimal?         @db.Decimal(10, 2)
  deliveryStatus        String?
  estimatedDeliveryTime DateTime?
  deliveryAddress       String?

  // takeaway-specific
  pickupTime      DateTime?
  packagingCharge Decimal?  @db.Decimal(10, 2)

  // money
  subtotal            Decimal @db.Decimal(12, 2)
  discountAmount      Decimal @default(0) @db.Decimal(12, 2)
  gstAmount           Decimal @default(0) @db.Decimal(12, 2)
  serviceChargeAmount Decimal @default(0) @db.Decimal(12, 2)
  grandTotal          Decimal @db.Decimal(12, 2)

  notes    String?
  outletId String
  outlet   Outlet  @relation(fields: [outletId], references: [id])

  items               OrderItem[]
  payments            Payment[]
  kitchenOrders       KitchenOrder[]
  invoice             Invoice?
  duePayment          DuePayment?
  billSplits          BillSplit[]
  discountsApplied    OrderDiscount[]
  loyaltyTransactions LoyaltyTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, orderNumber])
  @@unique([outletId, holdNumber])
  @@index([status])
  @@index([orderType])
  @@index([createdAt])
  @@index([outletId])
  // Postgres does NOT index a foreign key just because it's a foreign key,
  // and every one of these columns is filtered on by a screen that loads on
  // every shift. Without them those queries are sequential scans of the
  // whole orders table, so they get slower every day the restaurant trades.
  //
  // tableId: the floor view's per-table "current order" lookup, and the
  //   settled-orders-today query behind the Paid colour.
  @@index([tableId])
  // counterId: Counter Summary groups by it.
  @@index([counterId])
  // onlinePlatformId: the floor view's per-platform delivery grouping.
  @@index([onlinePlatformId])
  // Composites for the two filters that always travel together — every
  // report and board scopes by outlet AND then by status or date. A
  // composite serves those in one index lookup where two single-column
  // indexes make Postgres pick one and filter the rest by hand.
  @@index([outletId, status])
  @@index([outletId, createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2) // snapshot at order time
  totalPrice Decimal @db.Decimal(12, 2)
  notes      String? // customization, printed on KOT

  addOns            OrderItemAddOn[]
  kitchenOrderItems KitchenOrderItem[]

  createdAt DateTime @default(now())

  // Loaded for every order on every board, ticket and bill — and this table
  // is the largest in the schema, several rows per order. It had no index at
  // all, so each nested `items` include scanned all of it.
  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model AddOn {
  id        String  @id @default(uuid())
  outletId  String
  outlet    Outlet  @relation(fields: [outletId], references: [id])
  name      String
  price     Decimal @db.Decimal(10, 2)
  isEnabled Boolean @default(true)

  orderItemAddOns OrderItemAddOn[]
  menuItems       MenuItemAddOn[]

  createdAt DateTime @default(now())

  @@index([outletId])
  @@map("add_ons")
}

model OrderItemAddOn {
  id          String    @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addOnId     String
  addOn       AddOn     @relation(fields: [addOnId], references: [id])

  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(12, 2)

  @@map("order_item_add_ons")
}

model Discount {
  id             String       @id @default(uuid())
  code           String?
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2) // percent or fixed amount
  isActive       Boolean      @default(true)
  validFrom      DateTime?
  validTo        DateTime?
  usageLimit     Int?
  minOrderAmount Decimal?     @db.Decimal(12, 2)
  outletId       String
  outlet         Outlet       @relation(fields: [outletId], references: [id])

  orderDiscounts OrderDiscount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([outletId, code])
  @@index([outletId])
  @@map("discounts")
}

model OrderDiscount {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  discountId String?
  discount   Discount? @relation(fields: [discountId], references: [id])

  type           DiscountType
  amountDeducted Decimal      @db.Decimal(12, 2)
  reason         String?

  approvedById String?
  approvedBy   Employee? @relation("DiscountsApprovedBy", fields: [approvedById], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_discounts")
}

model Payment {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  method               PaymentMethod
  amount               Decimal       @db.Decimal(12, 2)
  status               PaymentStatus @default(UNPAID)
  transactionReference String?
  paidAt               DateTime?

  billSplitId String?
  billSplit   BillSplit? @relation(fields: [billSplitId], references: [id])

  createdAt DateTime @default(now())

  // Read on the floor view (paid vs printed), Counter Summary, and every
  // billing screen. Also had no index at all.
  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model BillSplit {
  id        String    @id @default(uuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  splitType SplitType
  label     String // e.g. "Customer A"
  amount    Decimal   @db.Decimal(12, 2)

  payments Payment[]

  createdAt DateTime @default(now())

  @@map("bill_splits")
}

model KitchenOrder {
  id        String      @id @default(uuid())
  outletId  String
  outlet    Outlet      @relation(fields: [outletId], references: [id])
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kotNumber String
  status    KotStatus   @default(NEW)
  priority  KotPriority @default(NORMAL)

  kitchenSectionId String
  kitchenSection   KitchenSection @relation(fields: [kitchenSectionId], references: [id])

  // Denormalised from Order.kitchenBranchId at ticket-creation time. Stored
  // here as well so the Kitchen Display can filter tickets without joining
  // through Order, and so re-routing an order later can't silently move
  // tickets that a kitchen has already started cooking.
  kitchenBranchId String?
  kitchenBranch   KitchenBranch? @relation(fields: [kitchenBranchId], references: [id])

  chefId String?
  chef   Employee? @relation("KOTsByChef", fields: [chefId], references: [id])

  // target time is a snapshot (sum/max of item prep times) so it doesn't
  // shift if MenuItem.prepTimeMinutes changes later
  targetPrepMinutes Int?
  isDelayed         Boolean @default(false)
  recallCount       Int     @default(0)

  // key lifecycle timestamps — cheap to read for live timers/dashboard;
  // full history of every transition lives in KitchenOrderStatusLog
  acceptedAt  DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
  completedAt DateTime?
  recalledAt  DateTime?

  items      KitchenOrderItem[]
  statusLogs KitchenOrderStatusLog[]
  notes      KitchenNote[]

  printedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([outletId, kotNumber])
  @@index([status])
  @@index([kitchenSectionId, status])
  @@index([isDelayed])
  @@index([outletId])
  // Every card on the floor view derives its colour from the KOTs belonging
  // to one order, so this is on the hot path for the whole dashboard.
  @@index([orderId])
  @@map("kitchen_orders")
}

model KitchenOrderItem {
  id             String       @id @default(uuid())
  kitchenOrderId String
  kitchenOrder   KitchenOrder @relation(fields: [kitchenOrderId], references: [id], onDelete: Cascade)
  orderItemId    String
  orderItem      OrderItem    @relation(fields: [orderItemId], references: [id])
  quantity       Int

  @@index([kitchenOrderId])
  @@index([orderItemId])
  @@map("kitchen_order_items")
}

model KitchenOrderStatusLog {
  id             String       @id @default(uuid())
  kitchenOrderId String
  kitchenOrder   KitchenOrder @relation(fields: [kitchenOrderId], references: [id], onDelete: Cascade)

  fromStatus KotStatus?
  toStatus   KotStatus

  changedById String?
  changedBy   Employee? @relation("KOTStatusChangedBy", fields: [changedById], references: [id])

  reason String? // e.g. "Recalled by waiter", "Modified item"

  createdAt DateTime @default(now())

  @@index([kitchenOrderId, createdAt])
  @@map("kitchen_order_status_logs")
}

model KitchenNote {
  id             String       @id @default(uuid())
  kitchenOrderId String
  kitchenOrder   KitchenOrder @relation(fields: [kitchenOrderId], references: [id], onDelete: Cascade)

  chefId String?
  chef   Employee? @relation("KitchenNotesByChef", fields: [chefId], references: [id])

  note      String
  createdAt DateTime @default(now())

  @@map("kitchen_notes")
}

model Invoice {
  id            String  @id @default(uuid())
  outletId      String
  outlet        Outlet  @relation(fields: [outletId], references: [id])
  orderId       String  @unique
  order         Order   @relation(fields: [orderId], references: [id])
  invoiceNumber String
  gstNumber     String?
  sentVia       String? // print / email / whatsapp — comma-separated or JSON if multiple
  pdfUrl        String?

  // Who actually took the payment and closed the bill. Comes from the
  // authenticated session at billing time (completeBilling's performedById),
  // never from the client, so it's a real audit trail rather than a label.
  //
  // Recorded on the INVOICE rather than the Order because it answers "who
  // billed this", which is a different question from Order.waiterId ("who
  // served this table") — the same order is routinely served by one person
  // and billed by another.
  cashierId String?
  cashier   Employee? @relation("InvoicesByCashier", fields: [cashierId], references: [id])

  createdAt DateTime @default(now())

  @@unique([outletId, invoiceNumber])
  @@index([outletId])
  @@map("invoices")
}

model LoyaltyTransaction {
  id         String   @id @default(uuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])

  points Int // signed: + earn / - redeem
  reason String?

  createdAt DateTime @default(now())

  @@index([outletId])
  @@map("loyalty_transactions")
}

// ─────────────────────────────────────────────
// MENU MANAGEMENT — ADDITIVE MODELS
// Paste this block at the end of your existing schema.prisma.
// These attach onto the existing MenuItem/AddOn/Category models
// without altering anything already defined above.
// ─────────────────────────────────────────────

// Small / Medium / Large style variants for a single menu item
model MenuVariant {
  id              String   @id @default(uuid())
  outletId        String
  outlet          Outlet   @relation(fields: [outletId], references: [id])
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name            String // e.g. "Small", "Medium", "Large"
  price           Decimal  @db.Decimal(10, 2)
  prepTimeMinutes Int?
  calories        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([outletId])
  @@map("menu_variants")
}

// Optional: restrict which add-ons show up for a given menu item in the
// admin/catalog UI. Not required by the POS order flow (AddOn/OrderItemAddOn
// already work independently of this) — purely a curation layer.
// If you never populate this table, every add-on stays available everywhere.
model MenuItemAddOn {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  addOnId    String
  addOn      AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([menuItemId, addOnId])
  @@map("menu_item_addons")
}

// Combo meals — bundle several menu items at a fixed price
model ComboMeal {
  id          String      @id @default(uuid())
  outletId    String
  outlet      Outlet      @relation(fields: [outletId], references: [id])
  name        String
  price       Decimal     @db.Decimal(10, 2)
  description String?
  imageUrl    String?
  isEnabled   Boolean     @default(true)
  items       ComboItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([outletId])
  @@map("combo_meals")
}

model ComboItem {
  id          String    @id @default(uuid())
  comboMealId String
  comboMeal   ComboMeal @relation(fields: [comboMealId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])
  quantity    Int       @default(1)

  @@map("combo_items")
}

// Audit trail — logged automatically whenever MenuItem.sellingPrice changes
model PriceHistory {
  id         String   @id @default(uuid())
  outletId   String
  outlet     Outlet   @relation(fields: [outletId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  oldPrice   Decimal  @db.Decimal(10, 2)
  newPrice   Decimal  @db.Decimal(10, 2)
  changedBy  String? // userAccountId (req.user.id) of whoever made the change
  changedAt  DateTime @default(now())

  @@index([outletId])
  @@map("price_history")
}

// General-purpose audit trail for sensitive actions that don't already
// have a dedicated model (price changes already have PriceHistory above).
// Used for: order deletion, login-account/role creation, and employee
// termination — see server/src/lib/auditLog.service.js for the write
// helper and which call sites use it. Deliberately NOT tied by a foreign
// key to Employee/Order/etc. — an audit log needs to survive even if the
// thing it describes (e.g. a deleted Order) no longer exists.
model AuditLog {
  id         String @id @default(uuid())
  outletId   String
  outlet     Outlet @relation(fields: [outletId], references: [id])
  action     String // e.g. "ORDER_DELETED", "LOGIN_ACCOUNT_CREATED", "EMPLOYEE_TERMINATED"
  entityType String // e.g. "Order", "Employee", "UserAccount"
  entityId   String

  performedById   String? // Employee.id of whoever did it — nullable for system-initiated actions
  performedByRole String? // role snapshot at the time, since a role can change later

  metadata  Json? // free-form details specific to the action (orderNumber, grandTotal, assigned role, etc.)
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([performedById])
  @@index([outletId])
  @@map("audit_logs")
}
